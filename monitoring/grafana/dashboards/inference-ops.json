        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(vllm:num_requests_running) or sum(llamacpp:requests_processing)",
          "legendFormat": "서버 내부 처리 중",
          "range": true
