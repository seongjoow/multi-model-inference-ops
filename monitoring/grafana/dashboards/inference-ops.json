    {
      "type": "timeseries",
      "id": 9,
      "title": "LLM 서버 KV cache 사용률",
      "description": "LLM 서버가 잡아 둔 GPU 메모리 중 대화 문맥(KV cache)이 차지한 비율. 100%에 가까우면 새 요청이 서버 안에서 기다린다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(vllm:kv_cache_usage_perc) or max(vllm:gpu_cache_usage_perc) or max(llamacpp:kv_cache_usage_ratio)",
          "legendFormat": "KV cache",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
