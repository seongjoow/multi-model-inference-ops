# cp .env.example .env  (또는 make env) 후 필요한 값만 바꾼다. 실험 조건을 바꿀 때는 이 파일과 커밋 해시를 실험 노트에 같이 남긴다.

LOG_LEVEL=INFO

# ---- LLM (게이트웨이)
# Mac: llama.cpp를 호스트에서 실행. EC2: docker-compose.gpu.yml이 http://vllm:8000 으로 덮어씀
LLM_BASE_URL=http://host.docker.internal:8080
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_MAX_INFLIGHT=64          # 게이트웨이 동시 요청 상한 (기준선은 넉넉하게, 최적화 실험에서 조정)
LLM_QUEUE_TIMEOUT_S=30       # 상한에 걸려 이만큼 기다리면 503
LLM_REQUEST_TIMEOUT_S=120

# ---- CV (게이트웨이)
CV_MAX_QUEUE=10000           # 큐가 이 길이 이상이면 429
CV_WAIT_TIMEOUT_S=60         # wait=true 요청의 최대 대기

# ---- CV 워커
CV_BACKEND=yolo              # yolo | dummy (모델 없이 고정 시간)
CV_MODEL=yolo11n.pt          # 버전 교체 실험: yolo26n.pt
CV_DEVICE=cpu                # Mac은 cpu. EC2는 gpu.yml이 0으로 덮어씀
CV_HALF=false
CV_IMGSZ=640
CV_BATCH_SIZE=8              # 배치 최대 크기
CV_MAX_WAIT_MS=10            # 배치를 채우려고 더 기다리는 최대 시간
CV_QUEUE_MODE=simple         # simple | reliable (장애 대응 실험에서 비교)
CV_MAX_ATTEMPTS=3            # reliable 모드 재시도 상한, 넘으면 DLQ
CV_TORCH_THREADS=0           # 0이면 torch 기본값. CPU 경합 실험에서 조정
CV_WORKERS=1                 # CV 워커 컨테이너 수 (docker compose의 replicas)

# ---- EC2 전용 (docker-compose.gpu.yml)
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_GPU_MEM_UTIL=0.5
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=32
